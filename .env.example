# OIA Funding V0 — environment (copy to .env; never commit real values)

# --- Supabase Cloud ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="public-anon-key"
# Service role key is used ONLY by apps/workers (bypasses RLS). Never expose to web client.
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# --- LLM provider (provider-neutral; one default in V0) ---
# OD-2: default provider. Supported: "anthropic" (default) | "openai"
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-5"
LLM_API_KEY="provider-api-key"

# --- Connectors ---
# EU Funding & Tenders Portal SEDIA search API (public). Key is the literal "SEDIA".
EU_FT_API_KEY="SEDIA"
EU_FT_BASE_URL="https://api.tech.ec.europa.eu/search-api/prod/rest/search"

# --- Scoring / gate (see packages/config/constants) ---
CONFIDENCE_FLOOR="70"

# --- Fetch politeness ---
FETCH_USER_AGENT="OIA-Funding/0.0 (internal research; contact ops)"
FETCH_TIMEOUT_MS="30000"

# --- TED discovery worker (Sprint 1; needs egress — runs in Docker on your machine) ---
# Optional: paste an exact expert query built on https://ted.europa.eu/en/expert-search
TED_QUERY=""
# Fallback when TED_QUERY is empty: BAWABA sectors → CPV
TED_SECTORS="AI,digital,creative"
TED_PAGE_SIZE="100"      # max 250
TED_MAX="5"              # max candidates to qualify per run
TED_BASE_URL="https://api.ted.europa.eu/v3/notices/search"
