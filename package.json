{
  "name": "oia",
  "private": true,
  "version": "0.0.0",
  "description": "Oolala Intelligence Agency — OIA Funding V0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "worker:bawaba": "pnpm --filter @oia/workers run start -- --project bawaba",
    "vis:j0-view": "bash infra/visibility/scripts/j0-view.sh coach-gari",
    "vis:j0-status": "bash infra/visibility/scripts/j0-status.sh coach-gari",
    "vis:j0-watch:install": "bash infra/visibility/scripts/j0-watch.sh install coach-gari",
    "vis:j0-watch:remove": "bash infra/visibility/scripts/j0-watch.sh remove coach-gari",
    "vis:j0-close": "bash infra/visibility/scripts/j0-close.sh coach-gari",
    "vis:j0-report": "bash infra/visibility/scripts/j0-report.sh report coach-gari",
    "vis:j0-verify": "bash infra/visibility/scripts/j0-report.sh verify coach-gari",
    "shyrka:parler": "pnpm --filter @oia/shyrka parler",
    "shyrka:resume": "pnpm --filter @oia/shyrka resume",
    "ml:rafraichir": "bash packages/money-lookup/scripts/rafraichir.sh",
    "ml:quotidien:install": "bash packages/money-lookup/scripts/quotidien.sh install",
    "ml:quotidien:remove": "bash packages/money-lookup/scripts/quotidien.sh remove"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
