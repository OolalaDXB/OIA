# CrawlSEO v0.3.6 — copy to .env (git-ignored) with scripts/init-env.sh.
# Values intentionally EMPTY. Never paste a value into this file.

# ---- Generated once by init-env.sh, then backed up off-machine (SECRETS.md) ----
CRAWLSEO_POSTGRES_PASSWORD=
# openssl rand -hex 32. ALSO encrypts stored Google tokens and API keys:
# generate once, back up, NEVER change (a new value makes them unreadable).
NEXTAUTH_SECRET=

# ---- Fixed ----
NEXTAUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
CRAWLSEO_UPDATE_CHECK=false
CRAWLSEO_HIDE_CLOUD_PROMO=true

# ---- Google OAuth (Search Console). Your own Google Cloud OAuth client. ----
# Authorised redirect URI to declare in Google Cloud:
#   http://localhost:3100/api/auth/callback/google
# Scopes: openid, email, profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional, higher PageSpeed quota for Core Web Vitals.
GOOGLE_PAGESPEED_KEY=

# ---- Registration ----
# false for the very first login only. Then set to true and restart
# (scripts/lock-crawlseo.sh does exactly that).
DISABLE_REGISTRATION=false
