# Secrets — never commit. Only *.env.example files (no values) are tracked.
.env
*.env
!*.env.example
.env.*
!.env.example

# Runtime output: dumps, J0 exports and Crawlie reports live OUTSIDE the repo
# (see BACKUP_DIR / OIA_VIS_DATA in scripts). Belt and braces in case one lands here.
*.sql
*.sql.gz
*.dump
backups/
exports/
crawlie-out/

# Versioned SQL migrations are the exception.
!migrations/0001_evidence.sql
!migrations/0002_decision_journal.sql
!migrations/0003_client_action_log.sql
!migrations/0004_auth_identity.sql
