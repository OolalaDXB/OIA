<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Passage quotidien du moteur à runTimeUtc, en heure locale du Mac (gabarit de scripts/engine-install.sh).
     Mac endormi à l'heure dite : launchd lance le passage au réveil. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oia.visibility.moteur.quotidien</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@VIS_ROOT@/scripts/engine-run.sh</string><string>--quotidien</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>@HOUR@</integer><key>Minute</key><integer>@MINUTE@</integer></dict>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string><key>HOME</key><string>@HOME@</string></dict>
  <key>StandardOutPath</key><string>@LOGS@/moteur-quotidien.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/moteur-quotidien.log</string>
</dict>
</plist>
