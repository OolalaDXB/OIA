<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- File de demandes du moteur : un passage toutes les 5 minutes (gabarit de scripts/engine-install.sh). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.oia.visibility.moteur</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@VIS_ROOT@/scripts/engine-run.sh</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <!-- Relancé seul après un plantage (pas plus d'une fois toutes les 5 minutes). -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>@PATH@</string><key>HOME</key><string>@HOME@</string></dict>
  <key>StandardOutPath</key><string>@LOGS@/moteur.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/moteur.log</string>
</dict>
</plist>
