# Elmo v0.7.7 — copy to .env (git-ignored) with scripts/init-env.sh, which
# fills the generated secrets. Values below are intentionally EMPTY.
# Never paste a value into this file.

# ---- Generated once by init-env.sh, then backed up off-machine (SECRETS.md) ----
ELMO_POSTGRES_PASSWORD=
# 32 random bytes, standard base64. Encrypts provider keys stored in the DB.
# Losing it = credentials in the DB cannot be decrypted after a restore.
ELMO_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
DEPLOYMENT_ID=

# ---- Fixed ----
DEPLOYMENT_MODE=local
APP_URL=http://localhost:1515
VITE_APP_URL=http://localhost:1515
APP_NAME=Elmo
APP_ICON=/icons/elmo-icon.svg
VITE_APP_NAME=Elmo
VITE_APP_ICON=/icons/elmo-icon.svg
DISABLE_TELEMETRY=1

# ---- Cadence: 1 run per day per target (J0 protocol) ----
DEFAULT_DELAY_HOURS=24
RUNS_PER_PROMPT=1

# =====================================================================
# CONFIGURATION À ZÉRO COÛT (décision 2026-11-06) : aucune dépense, aucune
# carte bancaire, aucun abonnement. Vérifier avec scripts/zero-cost-check.sh
# AVANT de démarrer le worker.
# =====================================================================

# ---- Mention judging (Jev) ----
# "stub" = juge local intégré à Elmo (mots repères, aucun appel réseau ;
# Elmo le réserve aux tests et au développement). Mention = correspondance
# nom / alias / domaine ; sentiment et position NON exploitables. Si Jev réel
# est branché plus tard, Elmo re-juge l'historique sur REPROCESS_DAYS.
# Ne jamais laisser vide : avec OPENROUTER_API_KEY, Jev passerait par OpenRouter.
TYPESAFE_API_KEY=stub

# ---- Model APIs ONLY. No scraping vendor key (Cloro, BrightData, Oxylabs,
#      SearchApi, Olostep, DataForSEO) may ever be set. ----
# OpenAI et Anthropic : NON utilisés (ChatGPT, Claude, Perplexity sont saisis à la
# main depuis leurs applications gratuites : subjects capture-template). Laisser vides.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Mistral, offre gratuite (Experiment / Free mode : téléphone vérifié, sans carte).
# Les requêtes de l'offre gratuite peuvent servir à l'entraînement de Mistral.
MISTRAL_API_KEY=
# OpenRouter, compte gratuit sans crédit, avec une clé Google AI Studio gratuite
# enregistrée en BYOK (OpenRouter > Settings > Integrations > Google AI Studio).
# Sert uniquement à Gemini. Sans crédit, un appel payant est refusé, jamais facturé.
OPENROUTER_API_KEY=

# Cibles : LAISSER VIDE jusqu'au démarrage de J0 (le worker refuse de démarrer
# sans, c'est le verrou). Valeur à J0 :
# SCRAPE_TARGETS=gemini:openrouter:google/gemini-2.5-flash:online,mistral:mistral-api:mistral-medium-latest
# - Gemini ":online" = recherche Google native, gratuite seulement si le quota
#   gratuit le permet (à confirmer par zero-cost-check.sh ; sinon retirer ":online").
#   Modèle à ajuster selon le quota gratuit affiché dans AI Studio.
# - Mistral SANS ":online" : la recherche web est facturée par appel. Pas d'URL citées.
# Elmo choisit les moteurs PAR MARQUE (Brand > LLM settings) : activer "mistral"
# seulement sur les marques dont le sujet le mesure (subjects elmo-brief <id>).
SCRAPE_TARGETS=
# Onboarding / assistant de prompts / Opportunités : Mistral (UE), décision maintenue.
# Avec une clé gratuite, la recherche structurée peut échouer : sans gravité,
# les panels sont déjà écrits.
ONBOARDING_LLM_TARGET=mistral:mistral-api

# ---- OIA scripts (read by scripts/cost-guard.sh, ignored by Elmo) ----
# Daily cost cap in USD (UTC day). Zéro coût : 0 = arrêt du worker dès le moindre
# coût estimé ou réel. Attention : Elmo ESTIME environ 0,005 $ par appel Mistral
# même sur l'offre gratuite : en zéro coût, le plafond porte sur le coût RÉEL
# (OpenRouter), pas sur l'estimation. Le worker s'arrête si le réel dépasse 0.
OIA_VIS_DAILY_CAP_USD=0
OIA_VIS_COST_SOURCE=real
