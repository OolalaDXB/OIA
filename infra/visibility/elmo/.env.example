# Elmo v0.7.7 — copy to .env (git-ignored) with scripts/init-env.sh, which
# fills the generated secrets. Values below are intentionally EMPTY.
# Never paste a value into this file.

# ---- Generated once by init-env.sh, then backed up off-machine (SECRETS.md) ----
ELMO_POSTGRES_PASSWORD=
# 32 random bytes, standard base64. Encrypts provider keys stored in the DB.
# Losing it = credentials in the DB cannot be decrypted after a restore.
ELMO_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
DEPLOYMENT_ID=

# ---- Fixed ----
DEPLOYMENT_MODE=local
APP_URL=http://localhost:1515
VITE_APP_URL=http://localhost:1515
APP_NAME=Elmo
APP_ICON=/icons/elmo-icon.svg
VITE_APP_NAME=Elmo
VITE_APP_ICON=/icons/elmo-icon.svg
DISABLE_TELEMETRY=1

# ---- Cadence: 1 run per day per target (J0 protocol) ----
DEFAULT_DELAY_HOURS=24
RUNS_PER_PROMPT=1

# =====================================================================
# CONFIGURATION PAYANTE PLAFONNÉE (décision 2026-11-08). Remplace la
# configuration zéro coût du 2026-11-06. Comptes et clés à ouvrir par
# Mickaël (hors nuit). cost-guard.sh arrête le worker au plafond mensuel
# OIA_VIS_MONTHLY_CAP_USD (défaut 30), avec une alerte à 24 $. AUCUNE
# valeur n'est mise ici. Les crédits prépayés et la recharge automatique
# désactivée chez chaque fournisseur restent la seule garantie réelle.
# =====================================================================

# ---- Mention judging (Jev) via OpenRouter ----
# TypeSafe en direct non utilisé : passer par OpenRouter pour avoir une seule
# facture et pour pouvoir plafonner côté OpenRouter. Avec OPENROUTER_API_KEY
# renseignée et TYPESAFE_API_KEY vide, Elmo route Jev vers OpenRouter.
TYPESAFE_API_KEY=

# ---- Model APIs ONLY. Aucune clé de scraping (Cloro, BrightData, Oxylabs,
#      SearchApi, Olostep, DataForSEO) ne peut être posée ici. ----
# OpenAI en direct (chatgpt). Clé prépayée + recharge automatique désactivée
# avant toute mesure.
OPENAI_API_KEY=
# Anthropic en direct (claude). ATTENTION : NE JAMAIS EXPORTER
# ANTHROPIC_API_KEY DANS LE SHELL — elle serait captée par Claude Code et
# pourrait alimenter un run de développement sans que ce soit mesuré ici.
# Voir SECRETS.md.
ANTHROPIC_API_KEY=
# Mistral en direct (mistral). Pour panels en français ; Conversations API
# avec outil web_search = recherche web (:online).
MISTRAL_API_KEY=
# OpenRouter : sert à Gemini et Perplexity, plus Jev. Crédit prépayé + pas
# de recharge auto. Pas de routage UE sans l'offre Business.
OPENROUTER_API_KEY=

# Cibles à J0 : les cinq moteurs. LAISSER VIDE tant que le worker ne doit
# pas démarrer (le worker refuse de démarrer sans, c'est le verrou). Valeur
# cible à J0 :
# SCRAPE_TARGETS=chatgpt:openai-api:gpt-6-luna:online,claude:anthropic-api:claude-haiku-5-5:online,gemini:openrouter:google/gemini-2.5-flash:online,perplexity:openrouter:perplexity/sonar:online,mistral:mistral-api:mistral-medium-latest:online
# Elmo choisit les moteurs PAR MARQUE (Brand > LLM settings). Mistral n'est
# activé que sur les marques bilingues ou francophones (voir subjects
# elmo-brief <id>).
SCRAPE_TARGETS=
# Onboarding / assistant de prompts / Opportunités : Mistral (UE).
ONBOARDING_LLM_TARGET=mistral:mistral-api

# ---- Plafonnement du coût (lu par scripts/cost-guard.sh, ignoré par Elmo) ----
# Plafond mensuel global en USD, mois UTC. 30 = alerte à 24 $ (80 %) puis
# arrêt du worker à 30 $ ou dès qu'un coût du mois devient illisible. Le
# plafond logiciel n'est PAS une garantie : seuls les crédits prépayés avec
# recharge automatique désactivée empêchent réellement un dépassement. Voir
# FOURNISSEURS.md § « Plafond logiciel et plafond réel ».
OIA_VIS_MONTHLY_CAP_USD=30
# Alerte émise quand le coût du mois dépasse ce seuil (0 = aucune alerte).
OIA_VIS_MONTHLY_ALERT_USD=24
# Source retenue pour le coût : max (par défaut), estimate ou real. Avec
# plusieurs fournisseurs, seul le réel par fournisseur peut être agrégé
# correctement : cost-guard.sh ne lit pour l'instant que les coûts
# OpenRouter en réel (Gemini/Perplexity/Jev). OpenAI, Anthropic, Mistral :
# à relever à la main dans leurs consoles (colonne manual_usd du journal).
OIA_VIS_COST_SOURCE=max
