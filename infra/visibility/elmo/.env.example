# Elmo v0.7.7 — copy to .env (git-ignored) with scripts/init-env.sh, which
# fills the generated secrets. Values below are intentionally EMPTY.
# Never paste a value into this file.

# ---- Generated once by init-env.sh, then backed up off-machine (SECRETS.md) ----
ELMO_POSTGRES_PASSWORD=
# 32 random bytes, standard base64. Encrypts provider keys stored in the DB.
# Losing it = credentials in the DB cannot be decrypted after a restore.
ELMO_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
DEPLOYMENT_ID=

# ---- Fixed ----
DEPLOYMENT_MODE=local
APP_URL=http://localhost:1515
VITE_APP_URL=http://localhost:1515
APP_NAME=Elmo
APP_ICON=/icons/elmo-icon.svg
VITE_APP_NAME=Elmo
VITE_APP_ICON=/icons/elmo-icon.svg
DISABLE_TELEMETRY=1

# ---- Cadence: 1 run per day per target (J0 protocol) ----
DEFAULT_DELAY_HOURS=24
RUNS_PER_PROMPT=1

# ---- Mention judging (Jev). The worker will not start without ONE of these. ----
# TYPESAFE_API_KEY wins if both are set. Without it, Jev goes through OpenRouter.
TYPESAFE_API_KEY=

# ---- Model APIs ONLY (no scraping vendor: Cloro/BrightData/Oxylabs/SearchApi/
#      Olostep/DataForSEO keys must stay unset) ----
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Targets — to be fixed at panel validation. Proposal (API mode, web search on):
#   chatgpt:openai-api:gpt-6-luna:online
#   claude:anthropic-api:<model>:online
#   gemini:openrouter:google/gemini-2.5-flash:online
#   perplexity:openrouter:perplexity/sonar:online
# All-OpenRouter variant (single key, also pays Jev):
#   chatgpt:openrouter:openai/gpt-6-luna:online,claude:openrouter:anthropic/claude-haiku-5.5:online,
#   gemini:openrouter:google/gemini-2.5-flash:online,perplexity:openrouter:perplexity/sonar:online
SCRAPE_TARGETS=
# Which direct key runs brand onboarding / the prompt assistant (optional pin).
ONBOARDING_LLM_TARGET=
