# Elmo v0.7.7 — copy to .env (git-ignored) with scripts/init-env.sh, which
# fills the generated secrets. Values below are intentionally EMPTY.
# Never paste a value into this file.

# ---- Generated once by init-env.sh, then backed up off-machine (SECRETS.md) ----
ELMO_POSTGRES_PASSWORD=
# 32 random bytes, standard base64. Encrypts provider keys stored in the DB.
# Losing it = credentials in the DB cannot be decrypted after a restore.
ELMO_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
DEPLOYMENT_ID=

# ---- Fixed ----
DEPLOYMENT_MODE=local
APP_URL=http://localhost:1515
VITE_APP_URL=http://localhost:1515
APP_NAME=Elmo
APP_ICON=/icons/elmo-icon.svg
VITE_APP_NAME=Elmo
VITE_APP_ICON=/icons/elmo-icon.svg
DISABLE_TELEMETRY=1

# ---- Cadence: 1 run per day per target (J0 protocol) ----
DEFAULT_DELAY_HOURS=24
RUNS_PER_PROMPT=1

# =====================================================================
# CONFIGURATION PAYANTE PLAFONNÉE (décision 2026-11-08). Remplace la
# configuration zéro coût du 2026-11-06. Comptes et clés à ouvrir par
# Mickaël (hors nuit). cost-guard.sh arrête le worker au plafond mensuel
# OIA_VIS_MONTHLY_CAP_USD (défaut 30), avec une alerte à 24 $. AUCUNE
# valeur n'est mise ici. Les crédits prépayés et la recharge automatique
# désactivée chez chaque fournisseur restent la seule garantie réelle.
# =====================================================================

# ---- Jev (juge des mentions) : TypeSafe EN DIRECT (décision 2026-11-07) ----
# Elmo appelle api.typesafe.ai quand TYPESAFE_API_KEY est posée, même si
# OPENROUTER_API_KEY l'est aussi (apps/worker/src/mention-judge/jev.ts).
# Coût réel à relever dans la console TypeSafe (non lu par cost-guard.sh).
TYPESAFE_API_KEY=

# ---- APIs directes des modèles (seuls fournisseurs directs d'Elmo 0.7.7) ----
# Aucune clé de scraping (Cloro, BrightData, Oxylabs, SearchApi, Olostep,
# DataForSEO) ne peut être posée ici.
# OpenAI en direct (chatgpt). Crédit prépayé, recharge automatique coupée.
OPENAI_API_KEY=
# Anthropic en direct (claude). Clé créée dans l'espace de travail dédié
# oia-visibility, avec limite de dépense. NE JAMAIS EXPORTER
# ANTHROPIC_API_KEY DANS LE SHELL : Claude Code la capterait (SECRETS.md).
ANTHROPIC_API_KEY=
# Mistral en direct (mistral). Conversations API + outil web_search (:online).
# Modèle mesuré : mistral-large-4 (décision 2026-11-07, Medium 3.5 déprécié).
MISTRAL_API_KEY=

# ---- OpenRouter : Gemini et Perplexity (retenu le 2026-11-07) ----
# Elmo 0.7.7 n'appelle Gemini, Perplexity et Grok QUE via OpenRouter (aucun
# fournisseur direct Google, Perplexity ou xAI dans le code). 5 $ de crédit
# prépayé, recharge automatique coupée, clé plafonnée à 5 $ par mois. Jev
# n'y passe pas (TypeSafe en direct). cost-guard.sh lit son solde réel.
OPENROUTER_API_KEY=

# ---- Clés NON lues par Elmo 0.7.7 : ne pas les poser ici ----
# Gemini (Google AI Studio), Perplexity et xAI (Grok) : Elmo n'a aucun
# fournisseur direct pour ces moteurs. Ces clés restent dans Proton Pass.
# Aucun adaptateur maison avant P3.

# Cibles à J0. LAISSER VIDE tant que le worker ne doit pas démarrer (le
# worker refuse de démarrer sans, c'est le verrou). Valeur cible J0, cinq
# moteurs (décisions 2026-11-07 ; slugs OpenRouter vérifiés sur
# openrouter.ai/api/v1/models le 2026-11-07) :
# SCRAPE_TARGETS=chatgpt:openai-api:gpt-6-luna:online,claude:anthropic-api:claude-sonnet-5-5:online,mistral:mistral-api:mistral-large-4:online,gemini:openrouter:google/gemini-3-flash-preview:online,perplexity:openrouter:perplexity/sonar:online
# Chaque modèle doit figurer dans la grille de prix de cost-guard.sh
# (src/cost-grid.ts), sinon le worker est arrêté au premier relevé.
# Grok (grok:openrouter:x-ai/grok-4.5:online) : pas pour J0, candidat pour
# une fenêtre ultérieure avec sa propre mesure de départ.
# Elmo choisit les moteurs PAR MARQUE (Brand > LLM settings).
SCRAPE_TARGETS=
# Onboarding / assistant de prompts / Opportunités : Mistral (UE).
# Elmo 0.7.7 n'honore que le fournisseur de cette variable : le modèle de
# l'onboarding est codé en dur (mistral-large-latest, mistral-api.ts:17).
# Aucun réglage ne le fixe à mistral-large-4 sans modifier Elmo : à vérifier
# au premier appel (runbook-j0.md, étape 3).
ONBOARDING_LLM_TARGET=mistral:mistral-api

# ---- Plafonnement du coût (lu par scripts/cost-guard.sh, ignoré par Elmo) ----
# Plafond mensuel global en USD, mois UTC. 30 = alerte à 24 $ (80 %) puis
# arrêt du worker à 30 $ ou dès qu'un coût du mois devient illisible. Le
# plafond logiciel n'est PAS une garantie : seuls les crédits prépayés avec
# recharge automatique désactivée empêchent réellement un dépassement. Voir
# FOURNISSEURS.md § « Plafond logiciel et plafond réel ».
OIA_VIS_MONTHLY_CAP_USD=30
# Alerte émise quand le coût du mois dépasse ce seuil (0 = aucune alerte).
OIA_VIS_MONTHLY_ALERT_USD=24
# Source retenue pour le coût : max (par défaut), estimate ou real. Avec
# plusieurs fournisseurs, seul le réel par fournisseur peut être agrégé
# correctement : cost-guard.sh ne lit en réel que le solde OpenRouter. Pour
# les autres, il recalcule le coût de chaque run avec la grille de prix des
# modèles retenus (src/cost-grid.ts). TypeSafe et les factures réelles :
# à relever à la main dans les consoles (colonne manual_usd du journal).
OIA_VIS_COST_SOURCE=max
