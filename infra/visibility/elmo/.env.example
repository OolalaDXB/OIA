# Elmo v0.7.7 — copy to .env (git-ignored) with scripts/init-env.sh, which
# fills the generated secrets. Values below are intentionally EMPTY.
# Never paste a value into this file.

# ---- Generated once by init-env.sh, then backed up off-machine (SECRETS.md) ----
ELMO_POSTGRES_PASSWORD=
# 32 random bytes, standard base64. Encrypts provider keys stored in the DB.
# Losing it = credentials in the DB cannot be decrypted after a restore.
ELMO_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
DEPLOYMENT_ID=

# ---- Fixed ----
DEPLOYMENT_MODE=local
APP_URL=http://localhost:1515
VITE_APP_URL=http://localhost:1515
APP_NAME=Elmo
APP_ICON=/icons/elmo-icon.svg
VITE_APP_NAME=Elmo
VITE_APP_ICON=/icons/elmo-icon.svg
DISABLE_TELEMETRY=1

# ---- Cadence: 1 run per day per target (J0 protocol) ----
DEFAULT_DELAY_HOURS=24
RUNS_PER_PROMPT=1

# ---- Mention judging (Jev) — décision 2026-11-05 : via OpenRouter ----
# The worker will not start without TYPESAFE_API_KEY or OPENROUTER_API_KEY.
# TYPESAFE_API_KEY must stay EMPTY: when set it wins over OpenRouter.
TYPESAFE_API_KEY=

# ---- Model APIs ONLY. No scraping vendor key (Cloro, BrightData, Oxylabs,
#      SearchApi, Olostep, DataForSEO) may ever be set. ----
# Décision 2026-11-05 : OpenAI et Anthropic en direct ; Gemini, Perplexity et Jev via OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Targets, web search on (":online"). These four exact strings are in Elmo's
# own scheduled provider tests (packages/config/src/scrape-targets.ts, v0.7.7).
# LEAVE EMPTY until the panels are validated: the worker refuses to start
# without it, which is the lock that keeps J0 from starting early.
# Value to set at J0:
# SCRAPE_TARGETS=chatgpt:openai-api:gpt-6-luna:online,claude:anthropic-api:claude-haiku-5-5:online,gemini:openrouter:google/gemini-2.5-flash:online,perplexity:openrouter:perplexity/sonar:online
SCRAPE_TARGETS=
# Onboarding / prompt assistant LLM, pinned so OpenRouter (set for Jev) does not take it over.
ONBOARDING_LLM_TARGET=claude:anthropic-api

# ---- OIA scripts (read by scripts/cost-guard.sh, ignored by Elmo) ----
# Daily cost cap in USD (UTC day). Décision 2026-11-05 : 5.
OIA_VIS_DAILY_CAP_USD=5
